[Unit]
Description=Aispace local administrator
After=network.target
[Service]
User=aispace-license
Group=aispace-license
WorkingDirectory=/opt/aispace-license
Environment=LICENSE_DATA=/var/lib/aispace-license
ExecStart=/opt/aispace-license/venv/bin/uvicorn license_service.admin_server:app --host 127.0.0.1 --port 8089 --no-access-log
Restart=on-failure
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aispace-license
[Install]
WantedBy=multi-user.target

